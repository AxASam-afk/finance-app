# Base de données Neon (intégration Vercel Storage)
# DATABASE_URL = connexion poolée (runtime serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED = connexion directe (migrations Prisma uniquement)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Assistant IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Accès mono-utilisateur (pas de vrai système d'auth multi-utilisateur)
APP_PASSWORD="change-me"
SESSION_SECRET="generer-une-chaine-aleatoire-longue"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
